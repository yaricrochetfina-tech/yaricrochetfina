# ---- Frontend (Vite) ----
# El pago NO usa VITE_STRIPE_PUBLISHABLE_KEY: el navegador llama a la Edge Function
# stripe-checkout, que crea la sesión con STRIPE_SECRET_KEY (secreto de Supabase).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key
# URL pública del sitio (se usa al compartir productos). Opcional.
VITE_SITE_URL=https://www.yaricrochet.com
# Moneda en la que cobra Stripe (debe coincidir con STORE_CURRENCY de las funciones).
VITE_STORE_CURRENCY=CAD

# ---- Secretos de Edge Functions (Supabase Dashboard → Edge Functions → Secrets) ----
# En producción DEBEN ser claves live. Si STRIPE_SECRET_KEY es sk_test_...,
# Checkout abre el modo de prueba y las tarjetas reales fallan.
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...   # webhook creado en modo Live de Stripe
#   STORE_CURRENCY=cad
#   SITE_URL=https://www.yaricrochet.com
#   ALLOWED_ORIGINS=https://www.yaricrochet.com
#   RESEND_FROM_EMAIL="Yari Crochet <pedidos@tu-dominio.com>"
#   ORDER_ADMIN_SECRET=un-secreto-largo

# ---- Scripts locales (solo .env.local; modo test) ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Script de YouTube Shorts (scripts/match-youtube-shorts.js) ----
# Opcional: si no está, el script usa SUPABASE_ACCESS_TOKEN de .env.local.
# SUPABASE_SERVICE_ROLE_KEY=
# Canal de YouTube del que se leen los Shorts.
# YOUTUBE_HANDLE=yarifina
