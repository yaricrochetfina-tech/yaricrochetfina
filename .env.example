# ---- Frontend (Vite) ----
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key
# URL pública del sitio (se usa al compartir productos). Opcional.
VITE_SITE_URL=https://www.yaricrochet.com
# Moneda en la que cobra Stripe (debe coincidir con STORE_CURRENCY de las funciones).
VITE_STORE_CURRENCY=CAD

# ---- Script de YouTube Shorts (scripts/match-youtube-shorts.js) ----
# Opcional: si no está, el script usa SUPABASE_ACCESS_TOKEN de .env.local.
# SUPABASE_SERVICE_ROLE_KEY=
# Canal de YouTube del que se leen los Shorts.
# YOUTUBE_HANDLE=yarifina
